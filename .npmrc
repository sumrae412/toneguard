# DO NOT put registry auth tokens in this file. It is tracked in git and
# pages.yml publishes the repo root, so a token written here by
# `npm config set ... --location=project` or `npm login` would be committed and
# served. Use ~/.npmrc for credentials.
#
# engine-strict makes the npm floor in package.json enforced rather than advisory.
# Why it is needed: npm 10 silently strips the "libc" platform fields npm 11
# writes into package-lock.json, degrading linux musl/glibc resolution with no
# error. That already landed on main once (952e9fd, 2026-04-03, -10 entries).
#
# devEngines alone is NOT sufficient and was tried first: npm below 10.9 ignores
# it entirely, and node 20 LTS bundles npm 10.8.2 — measured stripping all 10
# fields while reporting success. engine-strict is honoured by every npm 10.
engine-strict=true
